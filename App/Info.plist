<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>RoutePic</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.9</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- DESIGN.md §5.1: When In Use plus the background mode is sufficient for a
	     session the user starts in the foreground. "Always" is not requested;
	     it would raise the permission bar for a capability the app never uses. -->
	<key>NSHealthShareUsageDescription</key>
	<string>RoutePic reads the routes of walks, runs and rides you have already recorded, so your collection is not empty on the day you install it. Nothing is written back to Health, and no route leaves this device.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>RoutePic records the shape of your walk, run or drive so it can turn the route into a picture. Recording only happens while a session you started is running.</string>
	<!-- DESIGN.md §14.1: without this key `requestTemporaryFullAccuracy` fails,
	     and the only way past a reduced-accuracy refusal is the Settings app. -->
	<key>NSLocationTemporaryUsageDescriptionDictionary</key>
	<dict>
		<key>RecordingARoute</key>
		<string>A route drawn from approximate positions is not the shape you walked. Precise Location is used only while a session you started is running.</string>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
</dict>
</plist>
